{
	"name": "premid",
	"type": "module",
	"version": "1.0.0",
	"packageManager": "pnpm@9.5.0",
	"description": "Monorepo containing most of PreMiD's codebase",
	"author": {
		"name": "Recodive oHG",
		"email": "contact@recodive.com",
		"url": "https://recodive.com"
	},
	"license": "MPL-2.0",
	"engines": {
		"node": "^24.22.1"
	},
	"scripts": {
		"prepare": "husky",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"build": "pnpm clean && tsc -b tsconfig.app.json",
		"build:watch": "pnpm clean && tsc -b tsconfig.app.json -w",
		"clean": "tsc -b tsconfig.app.json --clean",
		"test": "vitest --run",
		"test:ui": "vitest --ui"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^2.27.3",
		"@commitlint/cli": "^19.8.1",
		"@commitlint/config-conventional": "^19.8.1",
		"@types/node": "^24.0.0",
		"@vitest/coverage-v8": "^2.1.9",
		"@vitest/ui": "^2.1.9",
		"bumpp": "^9.11.1",
		"eslint": "9.7.0",
		"eslint-plugin-format": "^0.1.3",
		"husky": "^9.1.7",
		"prettier": "^3.9.10",
		"typescript": "^5.9.3",
		"vitest": "^3.2.6"
	},
	"pnpm": {
		"overrides": {
			"@eslint-community/eslint-plugin-eslint-comments": "4.4.0",
			"happy-dom": "^20.8.9",
			"tar": "^7.5.21",
			"tinypool": "^2.1.2",
			"vite": "^6.4.4"
		}
	}
}
